# Twitch user token for a dedicated bot account. Prefix oauth: is optional.
ACCESS_TOKEN=
CLIENT_ID=
BOT_USERNAME=
CHANNEL_NAME=
# Optional follower lookup also needs moderator:read:followers.
API_ENABLED=false
API_PORT=3001
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
DEBUG=false
TELEGRAM_LINK=
CHAT_RULES=Не оскорбляйте участников, не спамьте и соблюдайте правила Twitch.

# observe: only log automatic decisions; active: execute automatic actions. Restart after editing.
AUTOMOD_MODE=observe

# Authorization Code Grant credentials. Do not paste these into chats or the panel.
REFRESH_TOKEN=
CLIENT_SECRET=
# confidential (default) or public, matching the Twitch application type.
OAUTH_CLIENT_TYPE=confidential
